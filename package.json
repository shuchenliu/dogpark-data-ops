{
    "name": "dogpark-data-ops",
    "version": "0.1.0",
    "description": "A very lovely package. Hooray!",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/shuchenliu/dogpark-data-ops.git"
    },
    "license": "MIT",
    "author": {
        "name": "shuchenliu",
        "email": "shuchenliu2014@gmail.com"
    },
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./release": {
            "types": "./lib/release/index.d.ts",
            "import": "./lib/release/index.js"
        }
    },
    "bin": {
        "dogpark-data": "bin/dogpark-data.js"
    },
    "files": [
        "bin/",
        "LICENSE.md",
        "README.md",
        "lib/",
        "package.json"
    ],
    "scripts": {
        "build": "tsdown",
        "dogpark-data": "node bin/dogpark-data.js",
        "format": "prettier .",
        "lint": "eslint . --max-warnings 0",
        "prepare": "tsdown",
        "prepare:hooks": "husky",
        "tsc": "tsc"
    },
    "lint-staged": {
        "*": "prettier --ignore-unknown --write"
    },
    "devDependencies": {
        "@eslint/js": "9.29.0",
        "@types/node": "24.0.4",
        "eslint": "9.29.0",
        "husky": "9.1.7",
        "lint-staged": "16.1.2",
        "prettier": "3.6.1",
        "tsdown": "0.12.7",
        "typescript": "5.8.3",
        "typescript-eslint": "8.35.0"
    },
    "packageManager": "pnpm@10.4.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "nanoid": "^5.1.6"
    }
}
